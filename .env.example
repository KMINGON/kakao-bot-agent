# Copy to .env. Secret values remain in .local/secret files, outside Git and images.
BOT_MODE=agent
MODEL_NAME=gpt-6.1-sol
# Optional: default, fast, priority, or ultrafast; empty uses the project default.
MODEL_SERVICE_TIER=
MAX_INPUT_TOKENS=48000
SUMMARY_TRIGGER_TOKENS=36000
ACTIVE_PACK=gyodong
RUNTIME_REVISION=contest-v1
LOCAL_API_PORT=8000
MAX_MODEL_CALLS=12
MAX_TOOL_CALLS=24
WORKER_CONCURRENCY=4
ACTION_API_WRITES_ENABLED=false
MONITOR_INTERVAL_SECONDS=60
MONITOR_DURATION_HOURS=48

